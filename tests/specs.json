[
  {
    "name": "client /start registration asks for a name then shows the menu",
    "steps": [
      { "send": { "text": "/start", "chatId": 5, "userId": 5 }, "expect": [{ "method": "sendMessage", "payload": { "text": "Welcome! What's your name?" } }] },
      { "send": { "text": "Sam", "chatId": 5, "userId": 5 }, "expect": [{ "method": "sendMessage" }] }
    ]
  },
  {
    "name": "a name that is too long is re-asked",
    "steps": [
      { "send": { "text": "/start", "chatId": 5, "userId": 5 }, "expect": [{ "method": "sendMessage", "payload": { "text": "Welcome! What's your name?" } }] },
      { "send": { "text": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx", "chatId": 5, "userId": 5 }, "expect": [{ "method": "sendMessage", "payload": { "text": "Please send a name (1–64 characters)." } }] }
    ]
  },
  {
    "name": "returning user /start goes straight to the menu",
    "steps": [
      { "send": { "text": "/start", "chatId": 5, "userId": 5 }, "expect": [{ "method": "sendMessage" }] },
      { "send": { "text": "Sam", "chatId": 5, "userId": 5 }, "expect": [{ "method": "sendMessage" }] },
      { "send": { "text": "/start", "chatId": 5, "userId": 5 }, "expect": [{ "method": "sendMessage", "payload": { "text": "Hi, Sam!" } }] }
    ]
  },
  {
    "name": "/help lists commands",
    "steps": [
      { "send": { "text": "/start", "chatId": 5, "userId": 5 }, "expect": [{ "method": "sendMessage" }] },
      { "send": { "text": "Sam", "chatId": 5, "userId": 5 }, "expect": [{ "method": "sendMessage" }] },
      { "send": { "text": "/help", "chatId": 5, "userId": 5 }, "expect": [{ "method": "sendMessage" }] }
    ]
  },
  {
    "name": "stray text outside a flow gets the fallback hint",
    "steps": [
      { "send": { "text": "/start", "chatId": 5, "userId": 5 }, "expect": [{ "method": "sendMessage" }] },
      { "send": { "text": "Sam", "chatId": 5, "userId": 5 }, "expect": [{ "method": "sendMessage" }] },
      { "send": { "text": "hello there", "chatId": 5, "userId": 5 }, "expect": [{ "method": "sendMessage", "payload": { "text": "Sorry, I didn't get that. /help shows what I can do." } }] }
    ]
  },
  {
    "name": "/book with an empty catalog explains there are no services",
    "steps": [
      { "send": { "text": "/start", "chatId": 5, "userId": 5 }, "expect": [{ "method": "sendMessage" }] },
      { "send": { "text": "Sam", "chatId": 5, "userId": 5 }, "expect": [{ "method": "sendMessage" }] },
      { "send": { "text": "/book", "chatId": 5, "userId": 5 }, "expect": [{ "method": "sendMessage", "payload": { "text": "No services available yet." } }] }
    ]
  },
  {
    "name": "/my with no appointments",
    "steps": [
      { "send": { "text": "/start", "chatId": 5, "userId": 5 }, "expect": [{ "method": "sendMessage" }] },
      { "send": { "text": "Sam", "chatId": 5, "userId": 5 }, "expect": [{ "method": "sendMessage" }] },
      { "send": { "text": "/my", "chatId": 5, "userId": 5 }, "expect": [{ "method": "sendMessage" }] }
    ]
  },
  {
    "name": "/cancel with no upcoming appointments",
    "steps": [
      { "send": { "text": "/start", "chatId": 5, "userId": 5 }, "expect": [{ "method": "sendMessage" }] },
      { "send": { "text": "Sam", "chatId": 5, "userId": 5 }, "expect": [{ "method": "sendMessage" }] },
      { "send": { "text": "/cancel", "chatId": 5, "userId": 5 }, "expect": [{ "method": "sendMessage", "payload": { "text": "You have no upcoming appointments." } }] }
    ]
  },
  {
    "name": "/reschedule with no upcoming appointments",
    "steps": [
      { "send": { "text": "/start", "chatId": 5, "userId": 5 }, "expect": [{ "method": "sendMessage" }] },
      { "send": { "text": "Sam", "chatId": 5, "userId": 5 }, "expect": [{ "method": "sendMessage" }] },
      { "send": { "text": "/reschedule", "chatId": 5, "userId": 5 }, "expect": [{ "method": "sendMessage", "payload": { "text": "You have no upcoming appointments." } }] }
    ]
  },
  {
    "name": "owner adds a service through the text-step flow",
    "steps": [
      { "send": { "text": "/start", "chatId": 9000, "userId": 9000 }, "expect": [{ "method": "sendMessage" }] },
      { "send": { "text": "Boss", "chatId": 9000, "userId": 9000 }, "expect": [{ "method": "sendMessage" }] },
      { "send": { "text": "/services", "chatId": 9000, "userId": 9000 }, "expect": [{ "method": "sendMessage", "payload": { "text": "Services:" } }] },
      { "send": { "callback": "svc:add", "chatId": 9000, "userId": 9000 }, "expect": [{ "method": "sendMessage", "payload": { "text": "Service name?" } }] },
      { "send": { "text": "Haircut", "chatId": 9000, "userId": 9000 }, "expect": [{ "method": "sendMessage", "payload": { "text": "Description?" } }] },
      { "send": { "text": "Classic cut", "chatId": 9000, "userId": 9000 }, "expect": [{ "method": "sendMessage" }] },
      { "send": { "text": "30", "chatId": 9000, "userId": 9000 }, "expect": [{ "method": "sendMessage", "payload": { "text": "Services:" } }] }
    ]
  },
  {
    "name": "a non-numeric service duration is re-asked",
    "steps": [
      { "send": { "text": "/start", "chatId": 9000, "userId": 9000 }, "expect": [{ "method": "sendMessage" }] },
      { "send": { "text": "Boss", "chatId": 9000, "userId": 9000 }, "expect": [{ "method": "sendMessage" }] },
      { "send": { "text": "/services", "chatId": 9000, "userId": 9000 }, "expect": [{ "method": "sendMessage" }] },
      { "send": { "callback": "svc:add", "chatId": 9000, "userId": 9000 }, "expect": [{ "method": "sendMessage" }] },
      { "send": { "text": "Beard", "chatId": 9000, "userId": 9000 }, "expect": [{ "method": "sendMessage" }] },
      { "send": { "text": "Trim", "chatId": 9000, "userId": 9000 }, "expect": [{ "method": "sendMessage" }] },
      { "send": { "text": "abc", "chatId": 9000, "userId": 9000 }, "expect": [{ "method": "sendMessage", "payload": { "text": "Please send a whole number of minutes greater than 0." } }] }
    ]
  },
  {
    "name": "owner edits a service",
    "steps": [
      { "send": { "text": "/start", "chatId": 9000, "userId": 9000 }, "expect": [{ "method": "sendMessage" }] },
      { "send": { "text": "Boss", "chatId": 9000, "userId": 9000 }, "expect": [{ "method": "sendMessage" }] },
      { "send": { "text": "/services", "chatId": 9000, "userId": 9000 }, "expect": [{ "method": "sendMessage" }] },
      { "send": { "callback": "svc:add", "chatId": 9000, "userId": 9000 }, "expect": [{ "method": "sendMessage" }] },
      { "send": { "text": "Haircut", "chatId": 9000, "userId": 9000 }, "expect": [{ "method": "sendMessage" }] },
      { "send": { "text": "Classic", "chatId": 9000, "userId": 9000 }, "expect": [{ "method": "sendMessage" }] },
      { "send": { "text": "30", "chatId": 9000, "userId": 9000 }, "expect": [{ "method": "sendMessage", "payload": { "text": "Services:" } }] },
      { "send": { "callback": "svc:edit:1", "chatId": 9000, "userId": 9000 }, "expect": [{ "method": "sendMessage", "payload": { "text": "Service name? (current: Haircut)" } }] },
      { "send": { "text": "Fade", "chatId": 9000, "userId": 9000 }, "expect": [{ "method": "sendMessage" }] },
      { "send": { "text": "Skin fade", "chatId": 9000, "userId": 9000 }, "expect": [{ "method": "sendMessage" }] },
      { "send": { "text": "45", "chatId": 9000, "userId": 9000 }, "expect": [{ "method": "sendMessage", "payload": { "text": "Services:" } }] }
    ]
  },
  {
    "name": "owner deletes a service with confirmation",
    "steps": [
      { "send": { "text": "/start", "chatId": 9000, "userId": 9000 }, "expect": [{ "method": "sendMessage" }] },
      { "send": { "text": "Boss", "chatId": 9000, "userId": 9000 }, "expect": [{ "method": "sendMessage" }] },
      { "send": { "text": "/services", "chatId": 9000, "userId": 9000 }, "expect": [{ "method": "sendMessage" }] },
      { "send": { "callback": "svc:add", "chatId": 9000, "userId": 9000 }, "expect": [{ "method": "sendMessage" }] },
      { "send": { "text": "Haircut", "chatId": 9000, "userId": 9000 }, "expect": [{ "method": "sendMessage" }] },
      { "send": { "text": "Classic", "chatId": 9000, "userId": 9000 }, "expect": [{ "method": "sendMessage" }] },
      { "send": { "text": "30", "chatId": 9000, "userId": 9000 }, "expect": [{ "method": "sendMessage" }] },
      { "send": { "callback": "svc:del:1", "chatId": 9000, "userId": 9000 }, "expect": [{ "method": "sendMessage", "payload": { "text": "Delete \"Haircut\"?" } }] },
      { "send": { "callback": "svc:del:1:yes", "chatId": 9000, "userId": 9000 }, "expect": [{ "method": "sendMessage", "payload": { "text": "Services:" } }] }
    ]
  },
  {
    "name": "owner adds a barber through the text-step flow",
    "steps": [
      { "send": { "text": "/start", "chatId": 9000, "userId": 9000 }, "expect": [{ "method": "sendMessage" }] },
      { "send": { "text": "Boss", "chatId": 9000, "userId": 9000 }, "expect": [{ "method": "sendMessage" }] },
      { "send": { "text": "/barbers", "chatId": 9000, "userId": 9000 }, "expect": [{ "method": "sendMessage", "payload": { "text": "Barbers:" } }] },
      { "send": { "callback": "barber:add", "chatId": 9000, "userId": 9000 }, "expect": [{ "method": "sendMessage", "payload": { "text": "Barber name?" } }] },
      { "send": { "text": "Alex", "chatId": 9000, "userId": 9000 }, "expect": [{ "method": "sendMessage", "payload": { "text": "Specialty? (e.g. fades, beard trims)" } }] },
      { "send": { "text": "fades", "chatId": 9000, "userId": 9000 }, "expect": [{ "method": "sendMessage", "payload": { "text": "Barbers:" } }] }
    ]
  },
  {
    "name": "owner reaches slot predefinition after adding a barber",
    "steps": [
      { "send": { "text": "/start", "chatId": 9000, "userId": 9000 }, "expect": [{ "method": "sendMessage" }] },
      { "send": { "text": "Boss", "chatId": 9000, "userId": 9000 }, "expect": [{ "method": "sendMessage" }] },
      { "send": { "text": "/barbers", "chatId": 9000, "userId": 9000 }, "expect": [{ "method": "sendMessage" }] },
      { "send": { "callback": "barber:add", "chatId": 9000, "userId": 9000 }, "expect": [{ "method": "sendMessage" }] },
      { "send": { "text": "Alex", "chatId": 9000, "userId": 9000 }, "expect": [{ "method": "sendMessage" }] },
      { "send": { "text": "fades", "chatId": 9000, "userId": 9000 }, "expect": [{ "method": "sendMessage" }] },
      { "send": { "text": "/slots", "chatId": 9000, "userId": 9000 }, "expect": [{ "method": "sendMessage", "payload": { "text": "Predefine slots — choose a barber:" } }] }
    ]
  },
  {
    "name": "client picking a service with no slots is told none are free",
    "steps": [
      { "send": { "text": "/start", "chatId": 9000, "userId": 9000 }, "expect": [{ "method": "sendMessage" }] },
      { "send": { "text": "Boss", "chatId": 9000, "userId": 9000 }, "expect": [{ "method": "sendMessage" }] },
      { "send": { "text": "/services", "chatId": 9000, "userId": 9000 }, "expect": [{ "method": "sendMessage" }] },
      { "send": { "callback": "svc:add", "chatId": 9000, "userId": 9000 }, "expect": [{ "method": "sendMessage" }] },
      { "send": { "text": "Haircut", "chatId": 9000, "userId": 9000 }, "expect": [{ "method": "sendMessage" }] },
      { "send": { "text": "Classic", "chatId": 9000, "userId": 9000 }, "expect": [{ "method": "sendMessage" }] },
      { "send": { "text": "30", "chatId": 9000, "userId": 9000 }, "expect": [{ "method": "sendMessage" }] },
      { "send": { "text": "/start", "chatId": 5, "userId": 5 }, "expect": [{ "method": "sendMessage" }] },
      { "send": { "text": "Sam", "chatId": 5, "userId": 5 }, "expect": [{ "method": "sendMessage" }] },
      { "send": { "text": "/book", "chatId": 5, "userId": 5 }, "expect": [{ "method": "sendMessage", "payload": { "text": "Book — choose a service:" } }] },
      { "send": { "callback": "bk:svc:1", "chatId": 5, "userId": 5 }, "expect": [{ "method": "sendMessage", "payload": { "text": "No free slots for this service yet." } }] }
    ]
  },
  {
    "name": "owner-only guard: a client is refused /services",
    "steps": [
      { "send": { "text": "/start", "chatId": 5, "userId": 5 }, "expect": [{ "method": "sendMessage" }] },
      { "send": { "text": "Sam", "chatId": 5, "userId": 5 }, "expect": [{ "method": "sendMessage" }] },
      { "send": { "text": "/services", "chatId": 5, "userId": 5 }, "expect": [{ "method": "sendMessage", "payload": { "text": "That's an owner-only action." } }] }
    ]
  },
  {
    "name": "owner-only guard: a client is refused /barbers and /slots",
    "steps": [
      { "send": { "text": "/start", "chatId": 5, "userId": 5 }, "expect": [{ "method": "sendMessage" }] },
      { "send": { "text": "Sam", "chatId": 5, "userId": 5 }, "expect": [{ "method": "sendMessage" }] },
      { "send": { "text": "/barbers", "chatId": 5, "userId": 5 }, "expect": [{ "method": "sendMessage", "payload": { "text": "That's an owner-only action." } }] },
      { "send": { "text": "/slots", "chatId": 5, "userId": 5 }, "expect": [{ "method": "sendMessage", "payload": { "text": "That's an owner-only action." } }] }
    ]
  }
]
